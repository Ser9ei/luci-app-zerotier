#!/bin/sh

MIN_IMMORTALWRT_MAJOR=23

# shellcheck disable=SC1091

[ -r /etc/openwrt_release ] && . /etc/openwrt_release || exit 0

case "$(printf '%s' "$DISTRIB_ID" | tr '[:upper:]' '[:lower:]')" in
	immortalwrt) ;;
	*) exit 0 ;;
esac

case "$DISTRIB_RELEASE" in
	SNAPSHOT*|snapshot*|"") rel=99 ;;
	*)
		rel="${DISTRIB_RELEASE#"${DISTRIB_RELEASE%%[0-9]*}"}"
		rel="${rel%%[!0-9]*}"
		;;
esac

[ "${rel:-0}" -ge "${MIN_IMMORTALWRT_MAJOR%%.*}" ] || exit 0

uci -q batch <<-EOF >/dev/null
	delete ucitrack.@zerotier[-1]
	commit ucitrack

	delete firewall.zerotier
	commit firewall
EOF

exit 0
