#!/bin/sh
# Copyright (C) 2026 Ser9ei
#
# TechRef: https://openwrt.org/docs/techref/rpcd
#
# Tests:
#   ubus -v list luci.zerotier
#   ubus -S call luci.zerotier getVersion
#   ubus -S call luci.zerotier getGlobalEnabled
#   ubus -S call luci.zerotier setGlobalEnabled
#   ubus -S call luci.zerotier getInterfaces

. /usr/share/libubox/jshn.sh

readonly CONFIG="zerotier"
readonly ZEROTIER_ONE="/usr/bin/zerotier-one"
readonly ZEROTIER_CLI="/usr/bin/zerotier-cli"
readonly LOG_TAG="rpcd:luci.zerotier"

log()
{
	[ -n "$1" ] || return 0
	case "$2" in
		err) logger -t "$LOG_TAG" -p daemon.err -- "$1" ;;
		war) logger -t "$LOG_TAG" -p daemon.warn -- "$1" ;;
		*) logger -t "$LOG_TAG" -p daemon.info -- "$1" ;;
	esac
}

json_error()
{
	json_init
	json_add_boolean "result" 0
	json_add_string "error" "$1"
	json_dump
	json_cleanup
}

is_executable() { [ -x "$1" ]; }
is_config_enabled() { [ "$(uci -q get "${CONFIG}.global.enabled")" = "1" ]; }

set_config_enabled()
{
	uci -q set "${CONFIG}".global.enabled=1 || return 1
	uci -q commit "$CONFIG" || return 1
}

get_version()
{
	local _version
	is_executable "$ZEROTIER_ONE" && _version="$("$ZEROTIER_ONE" -v 2>/dev/null)" || _version="ZeroTier not found"

	json_init
	json_add_string "version" "${_version:-Unknown}"
	json_dump
	json_cleanup
}

get_global_enabled()
{
	json_init
	is_config_enabled && json_add_boolean "enabled" 1 || json_add_boolean "enabled" 0
	json_dump
	json_cleanup
}

set_global_enabled()
{
	local _enabled=1

	if ! is_config_enabled; then
		set_config_enabled || _enabled=0
	fi
	print_json_bool "result" $_enabled
	return $((1-_enabled))
}

get_interfaces()
{
	if ! is_executable "$ZEROTIER_CLI"; then
		log "ZeroTier CLI not found or not executable: $ZEROTIER_CLI" err
		json_error "ZeroTier CLI not found"
		return 1
	fi

	local _networks="$("$ZEROTIER_CLI" -j listnetworks 2>/dev/null)"
	if [ $? -ne 0 -o -z "$_networks" ]; then
		json_error "Failed to get ZeroTier network list"
		return 1
	fi

	json_set_namespace "input"
	json_init

	if ! json_load "{\"networks\":$_networks}" || ! json_is_a networks array; then
		log "Invalid JSON returned by ZeroTier CLI" err
		json_cleanup
		json_set_namespace ""
		json_error "Invalid ZeroTier CLI response"
		return 1
	fi

	if ! json_select "networks"; then
		log "Invalid network list returned by ZeroTier CLI" err
		json_cleanup
		json_set_namespace ""
		json_error "Invalid ZeroTier network list"
		return 1
	fi

	json_set_namespace "output"
	json_init
	json_add_object "zerotier"
	json_add_array "interfaces"
	json_set_namespace "input"
	local _network=1
	while json_is_a "$_network" object; do
		local id name type status portDeviceName mac mtu
		local assignedAddresses ip_address rx_bytes tx_bytes

		json_select "$_network"
		json_get_vars id name type status portDeviceName mac mtu

		ip_address=""
		if json_select "assignedAddresses"; then
			json_get_values ip_address
			json_select ..
			ip_address="$(printf '%s\n' "$ip_address" | sed 's#[[:space:]]*/[^[:space:]]*##g')"
		fi

		json_select ..
		rx_bytes=""
		tx_bytes=""
		if [ -n "$portDeviceName" -a -d "/sys/class/net/$portDeviceName" ]; then
			rx_bytes="$(cat "/sys/class/net/${portDeviceName}/statistics/rx_bytes" 2>/dev/null)"
			tx_bytes="$(cat "/sys/class/net/${portDeviceName}/statistics/tx_bytes" 2>/dev/null)"
		fi

		json_set_namespace "output"
		json_add_object ""
		json_add_string "network_id" "$id"
		json_add_string "name" "$name"
		json_add_string "type" "$type"
		json_add_string "status" "$status"
		json_add_string "device_name" "$portDeviceName"
		json_add_string "mac" "$mac"
		json_add_string "ip_address" "$ip_address"
		json_add_string "mtu" "$mtu"
		json_add_string "rx_bytes" "$rx_bytes"
		json_add_string "tx_bytes" "$tx_bytes"
		json_close_object

		json_set_namespace "input"
		_network=$(( _network + 1 ))
	done
	json_cleanup

	json_set_namespace "output"
	json_close_array
	json_close_object
	json_dump
	json_cleanup
}

case "$1" in
	list)
		json_init

		json_add_object "getVersion"
		json_close_object

		json_add_object "getGlobalEnabled"
		json_close_object

		json_add_object "setGlobalEnabled"
		json_close_object

		json_add_object "getInterfaces"
		json_close_object

		json_dump
		json_cleanup
		;;
	call)
		case "$2" in
			getVersion)
				get_version
				;;
			getGlobalEnabled)
				get_global_enabled
				;;
			setGlobalEnabled)
				set_global_enabled
				json_cleanup
				;;
			getInterfaces)
				get_interfaces
				;;
			*)
				json_error "Unknown method: $2"
				exit 1
				;;
		esac
		;;
esac
