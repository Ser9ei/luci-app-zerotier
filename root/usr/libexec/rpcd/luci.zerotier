#!/bin/sh
# Copyright (C) 2026 Ser9ei
#
# TechRef: https://openwrt.org/docs/techref/rpcd
#
# Tests:
#   ubus -v list luci.zerotier
#   ubus -S call luci.zerotier getVersion
#   ubus -S call luci.zerotier getInitStatus
#   ubus -S call luci.zerotier setInitAction '{"action":"restart"}'
#   ubus -S call luci.zerotier getNetworks
#   ubus -S call luci.zerotier getPeers

. /usr/share/libubox/jshn.sh

readonly INIT_FILE="/etc/init.d/zerotier"
readonly CONFIG="zerotier"
readonly ZEROTIER_ONE="/usr/bin/zerotier-one"
readonly ZEROTIER_CLI="/usr/bin/zerotier-cli"
readonly LOG_TAG="rpcd:luci.zerotier"

log()
{
	[ -n "$1" ] || return 0
	case "$2" in
		err) logger -t "$LOG_TAG" -p daemon.err -- "$1" ;;
		war) logger -t "$LOG_TAG" -p daemon.warn -- "$1" ;;
		*) logger -t "$LOG_TAG" -p daemon.info -- "$1" ;;
	esac
}

json_error()
{
	json_init
	json_add_boolean "result" 0
	json_add_string "error" "$1"
	json_dump
	json_cleanup
}

is_executable() { [ -x "$1" ]; }
is_init_enabled() { "$INIT_FILE" enabled >/dev/null 2>&1; }
is_config_enabled() { [ "$(uci -q get "${CONFIG}.global.enabled")" = "1" ]; }
is_running() { "$INIT_FILE" running >/dev/null 2>&1; }

set_config_enabled()
{
	uci -q set "${CONFIG}".global.enabled=1 || return 1
	uci -q commit "$CONFIG" || return 1
}

init_action()
{
	if ! is_executable "$INIT_FILE"; then
		log "Init script not found or not executable: $INIT_FILE" err
		return 1
	fi

	local _result=0
	case "$1" in
		start)
			"$INIT_FILE" start >/dev/null 2>&1 || _result=1
			;;
		stop)
			"$INIT_FILE" stop >/dev/null 2>&1 || _result=1
			;;
		restart)
			"$INIT_FILE" restart >/dev/null 2>&1 || _result=1
			;;
		enable)
			"$INIT_FILE" enable >/dev/null 2>&1 || _result=1
			if ! is_config_enabled; then
				set_config_enabled || _result=1
			fi
			;;
		disable)
			"$INIT_FILE" disable >/dev/null 2>&1 || _result=1
			;;
		*)
			log "Unsupported init action: $1" war
			_result=1
			;;
	esac
	json_init
	json_add_boolean "result" $((1-_result))
	json_dump
	json_cleanup
	return "$_result"
}

get_version()
{
	local _version
	is_executable "$ZEROTIER_ONE" && _version="$("$ZEROTIER_ONE" -v 2>/dev/null)" || _version="ZeroTier not found"

	json_init
	json_add_string "version" "${_version:-Unknown}"
	json_dump
	json_cleanup
}

get_init_status()
{
	if ! is_executable "$INIT_FILE"; then
		log "Init script not found or not executable: $INIT_FILE" err
		json_error "Init script not found"
		return 1
	fi

	json_init
	json_add_object "zerotier"

	is_running && json_add_boolean "running" 1 || json_add_boolean "running" 0
	is_init_enabled && json_add_boolean "enabled" 1 || json_add_boolean "enabled" 0
	is_config_enabled && json_add_boolean "config_enabled" 1 || json_add_boolean "config_enabled" 0

	json_close_object
	json_dump
	json_cleanup
}

get_networks()
{
	if ! is_executable "$ZEROTIER_CLI"; then
		log "ZeroTier CLI not found or not executable: $ZEROTIER_CLI" err
		json_error "ZeroTier CLI not found"
		return 1
	fi

	local _dump="$("$ZEROTIER_CLI" -j listnetworks 2>/dev/null)"
	if [ $? -ne 0 -o -z "$_dump" ]; then
		json_error "Failed to get ZeroTier network list"
		return 1
	fi

	json_set_namespace "input"
	json_init

	if ! json_load "{\"networks\":$_dump}" || ! json_is_a networks array; then
		log "Invalid JSON returned by ZeroTier CLI" err
		json_cleanup
		json_set_namespace ""
		json_error "Invalid ZeroTier CLI response"
		return 1
	fi

	if ! json_select "networks"; then
		log "Invalid network list returned by ZeroTier CLI" err
		json_cleanup
		json_set_namespace ""
		json_error "Invalid ZeroTier network list"
		return 1
	fi

	json_set_namespace "output"
	json_init
	json_add_object "zerotier"
	json_add_array "networks"
	json_set_namespace "input"
	local _index=1
	local id name type status portDeviceName mac mtu assignedAddresses ip_address rx_bytes tx_bytes
	local _rx_bytes _tx_bytes
	while json_is_a "$_index" object; do
		json_select "$_index"
		json_get_vars id name type status portDeviceName mac mtu

		unset ip_address
		if json_select "assignedAddresses"; then
			json_get_values ip_address
			json_select ..
			ip_address="$(printf '%s\n' "$ip_address" | sed 's#[[:space:]]*/[^[:space:]]*##g')"
		fi

		json_select ..
		unset _rx_bytes
		unset _tx_bytes
		if [ -n "$portDeviceName" -a -d "/sys/class/net/$portDeviceName" ]; then
			_rx_bytes="$(cat "/sys/class/net/${portDeviceName}/statistics/rx_bytes" 2>/dev/null)"
			_tx_bytes="$(cat "/sys/class/net/${portDeviceName}/statistics/tx_bytes" 2>/dev/null)"
			[ -n "$mtu" ] || mtu="$(cat "/sys/class/net/${portDeviceName}/mtu" 2>/dev/null)"
		fi

		json_set_namespace "output"
		json_add_object ""
		json_add_string "network_id" "$id"
		json_add_string "name" "$name"
		json_add_string "type" "$type"
		json_add_string "status" "$status"
		json_add_string "device_name" "$portDeviceName"
		json_add_string "mac" "$mac"
		json_add_string "ip_address" "$ip_address"
		json_add_string "mtu" "$mtu"
		json_add_string "rx_bytes" "$_rx_bytes"
		json_add_string "tx_bytes" "$_tx_bytes"
		json_close_object

		json_set_namespace "input"
		_index=$((_index+1))
	done
	json_cleanup

	json_set_namespace "output"
	json_close_array
	json_close_object
	json_dump
	json_cleanup
}

get_peers()
{
	if ! is_executable "$ZEROTIER_CLI"; then
		log "ZeroTier CLI not found or not executable: $ZEROTIER_CLI" err
		json_error "ZeroTier CLI not found"
		return 1
	fi

	local _dump="$("$ZEROTIER_CLI" -j listpeers 2>/dev/null)"
	if [ $? -ne 0 -o -z "$_dump" ]; then
		json_error "Failed to get ZeroTier peer list"
		return 1
	fi

	json_set_namespace "input"
	json_init

	if ! json_load "{\"peers\":$_dump}" || ! json_is_a peers array; then
		log "Invalid JSON returned by ZeroTier CLI" err
		json_cleanup
		json_set_namespace ""
		json_error "Invalid ZeroTier CLI response"
		return 1
	fi

	if ! json_select "peers"; then
		log "Invalid peer list returned by ZeroTier CLI" err
		json_cleanup
		json_set_namespace ""
		json_error "Invalid ZeroTier peer list"
		return 1
	fi

	json_set_namespace "output"
	json_init
	json_add_object "zerotier"
	json_add_array "peers"
	json_set_namespace "input"
	local _index=1 _ipath
	local address version role tunneled latency link preferred
	local _path_address
	while json_is_a "$_index" object; do
		json_select "$_index"
		json_get_vars address version role tunneled latency
		[ "${version:--1.-1.-1}" = "-1.-1.-1" ] && unset version
		[ "$latency" = "-1" ] && unset latency
		[ "$tunneled" = "1" ] && link="RELAY" || link="DIRECT"

		unset _path_address
		if json_select "paths"; then
			_ipath=1
			while json_is_a "$_ipath" object; do
				json_select "$_ipath"
				json_get_var preferred preferred
				if [ "$preferred" = "1" ]; then
					json_get_var _path_address address
					json_select ..
					break
				fi
				json_select ..
				_ipath=$((_ipath+1))
			done
			json_select ..
		fi

		json_select ..

		json_set_namespace "output"
		json_add_object ""
		json_add_string "address" "$address"
		json_add_string "version" "$version"
		json_add_string "role" "$role"
		json_add_string "latency" "$latency"
		json_add_string "link" "$link"
		json_add_string "path" "$_path_address"
		json_close_object

		json_set_namespace "input"
		_index=$((_index+1))
	done
	json_cleanup

	json_set_namespace "output"
	json_close_array
	json_close_object
	json_dump
	json_cleanup
}

case "$1" in
	list)
		json_init

		json_add_object "getVersion"
		json_close_object

		json_add_object "getInitStatus"
		json_close_object

		json_add_object "setInitAction"
		json_add_string "action" "action"
		json_close_object

		json_add_object "getNetworks"
		json_close_object

		json_add_object "getPeers"
		json_close_object

		json_dump
		json_cleanup
		;;
	call)
		case "$2" in
			getVersion)
				get_version
				;;
			getInitStatus)
				get_init_status
				;;
			setInitAction)
				read -r input
				json_load "$input"
				json_get_var action "action"
				json_cleanup
				init_action "$action"
				;;
			getNetworks)
				get_networks
				;;
			getPeers)
				get_peers
				;;
			*)
				json_error "Unknown method: $2"
				exit 1
				;;
		esac
		;;
esac
