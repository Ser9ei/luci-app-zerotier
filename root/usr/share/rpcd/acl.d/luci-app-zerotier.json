{
	"luci-app-zerotier": {
		"description": "Grant access to ZeroTier configuration",
		"read": {
			"ubus": {
				"luci.zerotier": [
					"getVersion",
					"getGlobalEnabled",
					"getInterfaces"
				],
				"rc": [ "list" ]
			},
			"uci": [ "zerotier" ]
		},
		"write": {
			"ubus": {
				"luci.zerotier": [ "setGlobalEnabled" ],
				"rc": [ "init" ]
			},
			"uci": [ "zerotier" ]
		}
	}
}
